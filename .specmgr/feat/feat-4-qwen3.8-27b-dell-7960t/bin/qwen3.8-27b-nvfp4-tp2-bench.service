[Unit]
Description=vLLM Qwen3.8-27B NVFP4 (Phase 4 diagnostic: TP=2, GPU2+GPU0, throughput benchmark)
After=network.target
Wants=network.target

[Service]
Type=notify
WorkingDirectory=/data/qwen3.8-27b
Environment=PATH=/data/qwen3.8-27b/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/data/qwen3.8-27b/.venv/lib/python3.12/site-packages/nvidia/cu13/bin
Environment=HF_HOME=/data/nvidia/hf_cache
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=CUDA_VISIBLE_DEVICES=GPU-7eea2a46-7ce4-e288-ab02-783dc5c5c9ea,GPU-5200c9f6-a6bc-e388-2bfc-0e6ddce48ad4
ExecStart=/data/qwen3.8-27b/.venv/bin/vllm serve unsloth/Qwen3.8-27B-NVFP4 \
    --revision 7d6f8d4d72f56b92b3cdbf22f156b90e1bab0108 \
    --served-model-name qwen3.8-27b-nvfp4-tp2-bench \
    --tensor-parallel-size 2 \
    --max-model-len 8192 \
    --max-num-seqs 512 \
    --gpu-memory-utilization 0.9 \
    --tool-call-parser qwen3_xml \
    --enable-auto-tool-choice \
    --reasoning-parser qwen3 \
    --host 0.0.0.0 \
    --port 8004 \
    --trust-remote-code
ExecReload=/bin/kill -HUP $MAINPID
KillMode=control-group
Restart=on-failure
RestartSec=10
TimeoutStartSec=3600
TimeoutStopSec=60
LimitNOFILE=65536
LimitMEMLOCK=infinity

[Install]
WantedBy=default.target
